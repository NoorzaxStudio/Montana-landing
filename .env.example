# Google Sheet (Apps Script web app) that stores the consultation form.
# Put the real values in Vercel > Settings > Environment Variables, never in GitHub.
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_TOKEN=put-the-token-from-the-apps-script-here
# Public site address, used for SEO links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
