# Montana landing: clean URLs on Apache (Bluehost)
DirectoryIndex index.php
ErrorDocument 404 /404.php
Options -Indexes
AddType application/manifest+json .webmanifest

# Helper files are included by other pages, never opened directly.
<FilesMatch "^lib-">
  Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule ^api/prices/?$ prices.php [L]
RewriteRule ^go/?$ go.php [L]
RewriteRule ^admin/?$ admin.php [L]
RewriteRule ^lead/?$ lead.php [L]
RewriteRule ^signal/?$ signal.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^privacy/?$ privacy.php [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
</IfModule>
